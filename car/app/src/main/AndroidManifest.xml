<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- 조회 전용: EV SOC·연료% 읽기(충전·주유 권장), 충전 포트 열림(출발 전 점검). 제어 권한(CONTROL_CAR_*)은 선언하지 않음. -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 조회 전용: 주행가능거리(Odometer.getRangeRemainingDistance는 CAR_DRIVE 필요, Vehicle 2.3.2), 그리고 기어(P)·주행 모드·누적 주행거리 조회. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 조회 전용: 출력 제한 경고·워셔액·엔진오일·브레이크액(Safety) → 출발 전 점검. PRIVATE_CAR_SAFETY가 필요한 API(경고등 getTelltalesInfo·공기압 값)는 쓰지 않음. -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 조회 전용: 문 열림(Door.getCurrentDoorPosition) → 출발 전 점검. 잠금·개폐 제어는 하지 않음. -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- 조회 전용: 착좌·안전벨트(Seat) → 출발 전 점검의 '탑승 n명 중 m명 미착용'. 좌석 위치·열선 제어는 하지 않음. -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 내비로 구간을 재는 동안(사용자가 누른 뒤 1~2분)만 앱이 멈추지 않게 하는 짧은 포그라운드 서비스. 내비가 앞에 나오면 뒤에 있는 앱은 시스템이 정지시킴. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <uses-library android:name="android.car" android:required="false" />
        <!-- Pleos: CCP(로터리 컨트롤러)를 지원하지 않는 앱은 명시. 최상위 화면의 뒤로는 moveTaskToBack(true). -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".navi.MeasureService" android:exported="false" android:foregroundServiceType="shortService" />
    </application>
</manifest>
