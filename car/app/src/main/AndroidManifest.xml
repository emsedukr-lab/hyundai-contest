<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- 조회 전용: EV SOC·연료% 읽기(충전·주유 권장). 제어 권한(CONTROL_CAR_*)은 선언하지 않음. -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 조회 전용: 주행가능거리(Odometer.getRangeRemainingDistance는 CAR_DRIVE 필요, Vehicle 2.3.2). 다른 주행 API는 쓰지 않음. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <uses-library android:name="android.car" android:required="false" />
        <!-- Pleos: CCP(로터리 컨트롤러)를 지원하지 않는 앱은 명시. 최상위 화면의 뒤로는 moveTaskToBack(true). -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
