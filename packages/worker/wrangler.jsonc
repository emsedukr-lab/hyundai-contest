{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tteonaljido",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PAIRING", "class_name": "PairingSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairingSession"] }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CLAIM", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ROUTE", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
  ],
  // Off on purpose: request logs would keep URLs and client addresses, and the privacy design promises neither is stored.
  "observability": { "enabled": false }
}
