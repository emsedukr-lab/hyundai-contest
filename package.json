{
  "name": "tteonaljido",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/worker",
    "packages/web"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @tteonaljido/web",
    "dev": "npm run build -w @tteonaljido/web && npm run dev -w @tteonaljido/worker",
    "schema": "npm run schema -w @tteonaljido/shared",
    "e2e": "tsx tools/e2e-mobile.mts",
    "smoke": "tsx tools/pairing-smoke.mts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "tsx": "4.23.15"
  }
}
